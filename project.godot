; Engine configuration file.
config_version=5

[application]
config/name="Midcreek Hero"
config/icon="res://art/cel-shift/ui/icon.png"
boot_splash/bg_color=Color(0.03, 0.05, 0.08, 1)
boot_splash/show_image=true
boot_splash/image="res://art/cel-shift/ui/frames/title/00.png"
boot_splash/use_filter=false
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.85, 0.87, 0.9, 1)
